{% extends "base.html" %}{% block content %}<div class="max-w-4xl mx-auto p-6"><h2 class="text-2xl font-bold">🛒 Soko la Mazao - Migori</h2><div class="bg-white p-4 rounded-xl shadow mt-4"><h3 class="font-bold">Uza Mazao Yako</h3><form id="sellForm" class="grid grid-cols-2 gap-2 mt-2"><input name="name" placeholder="Jina lako" class="border p-2 rounded"><input name="crop" placeholder="Zao e.g Mahindi" class="border p-2 rounded"><input name="price" placeholder="Bei KSh" class="border p-2 rounded"><input name="location" placeholder="Mahali e.g Migori" class="border p-2 rounded"><input name="phone" placeholder="Namba 07..." class="border p-2 rounded col-span-2"><button class="bg-green-700 text-white p-2 rounded col-span-2">Weka Sokoni</button></form></div><div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">{% for s in sellers %}<div class="bg-white p-4 rounded-xl shadow"><p class="font-bold">{{s.crop}} - KSh {{s.price}}</p><p class="text-sm">{{s.name}} - {{s.location}}</p><p class="text-xs text-gray-500">{{s.date}}</p><a href="tel:{{s.phone}}" class="bg-green-600 text-white px-3 py-1 rounded-full text-xs mt-2 inline-block">Piga {{s.phone}}</a></div>{% endfor %}</div></div><script>document.getElementById('sellForm').onsubmit=async e=>{e.preventDefault();let fd=new FormData(e.target);let r=await fetch('/add_product',{method:'POST',body:fd});alert('✅ Imewekwa sokoni!');location.reload();};</script>{% endblock %}
