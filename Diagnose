{% extends "base.html" %}{% block content %}<div class="max-w-2xl mx-auto bg-white p-6 rounded-xl shadow mt-6"><h2 class="font-bold text-xl text-center">🔬 Daktari - KSh 20</h2><div id="badge" class="bg-green-100 border p-3 rounded mt-3 text-center font-bold">✅ 3 FREE SCANS</div><form id="form" enctype="multipart/form-data" class="mt-4 space-y-3"><input name="phone" placeholder="Namba yako 07..." class="w-full border-2 p-3 rounded" required><div class="grid grid-cols-2 gap-2"><button type="button" onclick="setCat('crop')" id="bCrop" class="bg-green-700 text-white p-3 rounded-lg font-bold">🌽 Mmea</button><button type="button" onclick="setCat('animal')" id="bAnimal" class="bg-gray-200 p-3 rounded-lg font-bold">🐄 Mnyama</button></div><input type="hidden" name="category" id="cat" value="crop"><input type="file" name="image" id="img" accept="image/*" capture="environment" class="w-full border-2 border-dashed p-4 rounded" required><img id="preview" class="hidden w-full h-60 object-cover rounded mt-2"><button class="bg-red-600 text-white w-full p-4 rounded-xl font-bold">🔍 Chunguza Sasa</button></form><div id="payBox" class="hidden bg-white border-2 border-green-600 p-5 rounded-xl mt-4"><h3 class="font-bold text-center">💰 Lipa KSh 20 Send Money: 0795001649</h3><input id="mpesaCode" placeholder="Weka M-Pesa Code QAS1X2Y3Z4" class="w-full border-2 border-green-600 p-3 rounded-lg text-center font-bold uppercase mt-3"><button onclick="verifyCode()" class="bg-green-700 text-white w-full p-3 rounded-lg mt-2 font-bold">✅ Thibitisha</button></div><div id="result" class="hidden mt-6"></div></div><script>let phone="",cat="crop";function setCat(c){cat=c;document.getElementById('cat').value=c;document.getElementById('bCrop').className=c=='crop'?'bg-green-700 text-white p-3 rounded-lg font-bold':'bg-gray-200 p-3 rounded-lg';document.getElementById('bAnimal').className=c=='animal'?'bg-green-700 text-white p-3 rounded-lg font-bold':'bg-gray-200 p-3 rounded-lg';}document.getElementById('img').onchange=e=>{let r=new FileReader();r.onload=f=>{document.getElementById('preview').src=f.target.result;document.getElementById('preview').classList.remove('hidden');};r.readAsDataURL(e.target.files[0]);};document.getElementById('form').onsubmit=async e=>{e.preventDefault();let fd=new FormData(e.target);phone=fd.get("phone");document.getElementById('result').innerHTML="<p class='p-10 text-center'>🔬 AI inachunguza...</p>";document.getElementById('result').classList.remove('hidden');let res=await fetch('/diagnose_crop',{method:'POST',body:fd});let j=await res.json();if(j.need_payment){document.getElementById('result').classList.add('hidden');document.getElementById('payBox').classList.remove('hidden');return;}document.getElementById('result').innerHTML=`<img src="${j.image_url}" class="w-full h-64 object-cover rounded"><div class="p-3 mt-2 space-y-2"><h2 class="text-xl font-bold text-red-600">${j.name_sw}</h2><div class="bg-yellow-50 p-3 rounded"><b>Dalili:</b> ${j.symptoms}</div><div class="bg-green-50 p-3 rounded"><b>Matibabu:</b> ${j.treatment}</div><div class="bg-blue-50 p-3 rounded"><b>Kinga:</b> ${j.prevention}</div><div class="bg-red-50 p-3 rounded"><b>Daktari:</b> ${j.vet}</div></div>`;};async function verifyCode(){let code=document.getElementById('mpesaCode').value.trim().toUpperCase();let fd=new FormData();fd.append("phone",phone);fd.append("code",code);let r=await fetch('/verify_transaction',{method:'POST',body:fd});let j=await r.json();alert(j.message);if(j.success){document.getElementById('payBox').classList.add('hidden');}}</script>{% endblock %}
